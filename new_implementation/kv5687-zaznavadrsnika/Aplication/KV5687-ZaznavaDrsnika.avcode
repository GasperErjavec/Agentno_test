public Inicializacija() step
{

section INITIALIZE:
	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_init_offline
	)
	Exit (inCondition: con_init_offline)
	Beckhoff_Init
	(
	)
}

public CheckIf_Start_Enabled(Bool outStartEnabled) step
{

section INITIALIZE:
	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_cse_offline
	)
	Not
	(
		inValue: con_cse_offline
		outValue: con_cse_online
	)
	Exit (inCondition: con_cse_online)
	expression
	{
		Bool outTrue = "True"
	}
	(
		outTrue: con_cse_true
	)
	parameters write
	{
		inputs: StartEnabled
	}
	(
		inStartEnabled: con_cse_true
	)
	outStartEnabled = con_cse_true

section PROCESS:
	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_cse_offline2
	)
	Exit (inCondition: con_cse_offline2)
	Beckhoff_GetStart
	(
		outValue: con_ba75e76d_287e_4f48_b41b_f50ca42cd52a
	)
	parameters write
	{
		inputs: StartEnabled
	}
	(
		inStartEnabled: con_ba75e76d_287e_4f48_b41b_f50ca42cd52a
	)
	outStartEnabled = con_ba75e76d_287e_4f48_b41b_f50ca42cd52a
}

public CheckIf_Sirena_Enabled(Bool outSirenaEnabled) step
{

section INITIALIZE:
	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_cse2_offline
	)
	Not
	(
		inValue: con_cse2_offline
		outValue: con_cse2_online
	)
	Exit (inCondition: con_cse2_online)
	expression
	{
		Bool outTrue = "True"
	}
	(
		outTrue: con_cse2_true
	)
	outSirenaEnabled = con_cse2_true

section PROCESS:
	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_cse2_offline2
	)
	Exit (inCondition: con_cse2_offline2)
	Beckhoff_GetSirena
	(
		outValue: con_fd559b4b_7d5d_4fd5_9f58_3a9056990a8b
	)
	outSirenaEnabled = con_fd559b4b_7d5d_4fd5_9f58_3a9056990a8b
}

//:SECTIONSVISIBILITY Visible
public WaitFor_Start(String inMM)
{

section INITIALIZE:
	expression
	{
		String inMM
		String outMessage = "\"[\" + inMM + \"]\" + \"Čakam na Start...\""
	}
	(
		inMM: inMM
		outMessage: con_99b88a59_7c6e_405d_9807_da77daa01674
	)

	WriteLog
	(
		inMessage: con_99b88a59_7c6e_405d_9807_da77daa01674
		inLogLevel: Info
	)

section PROCESS:
	Loop
	(
		inShouldLoop: True
		inDelay: 0
	)

	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_wfs_offline
	)
	Exit (inCondition: con_wfs_offline)

	parameters read
	{
		outputs: StartEnabled
	}
	(
		outStartEnabled: con_ba8f5fbb_b307_4239_a95b_ace9fe95ad46
	)

	Exit
	(
		inCondition: con_ba8f5fbb_b307_4239_a95b_ace9fe95ad46
	)
}

public WaitFor_Online()
{

section PROCESS:
	Loop
	(
		inShouldLoop: True
		inDelay: 100
	)

	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_wfo_offline
	)
	Not
	(
		inValue: con_wfo_offline
		outValue: con_wfo_online
	)
	Exit (inCondition: con_wfo_online)
}

