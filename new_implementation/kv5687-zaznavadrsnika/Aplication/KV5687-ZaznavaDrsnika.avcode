public SemaforSirena(Bool inStartEnabled, Bool inSirenaEnabled, Bool inAlarmLevoLevel1, Bool inAlarmLevoLevel2, Bool inAlarmDesnoLevel1, Bool inAlarmDesnoLevel2) step
{
	expression
	{
		Bool inStartEnabled
		Bool inSirenaEnabled
		Bool inAlarmLevoLevel1
		Bool inAlarmLevoLevel2
		Bool inAlarmDesnoLevel1
