//:SECTIONSVISIBILITY Visible
//:USETYPE WORKERTASK
public Simulacija()
{

section WAIT_FOR_OFFLINE:
	Loop
	(
		inShouldLoop: True
		inDelay: 1000
	)

	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_sim_offline_check
	)
	Exit (inCondition: con_sim_offline_check)

section ACQUIRE:
	//:HIDDENPORT[outFilePath.Length] TRUE
	//:HIDDENPORT[outFileName.Length] TRUE
	EnumerateImages
	(
		inDirectory: ext_OfflineImagesDir
		inFileType: Nil
		inSortingOrder: Name
		inRepeat: True
		inProcessSubdirectories: False
		inInvert: False
		inLoadAlphaChannel: False
		inDelay: 0
		outImage: con_377635aa_2f54_4be8_8f31_8a34ef8bdcf6
		outFilePath: Nil
		outFileName: Nil
		outIsFirst: Nil
		outIsLast: Nil
		outFilePath.Length: Nil
		outFileName.Length: Nil
	)

section PROCESS:
	Loop
	(
		inShouldLoop: True
		inDelay: 2000
	)

	CopyObject<Bool>
	(
		inObject: ext_OfflineMode
		outObject: con_sim_still_offline
	)
	Not
	(
		inValue: con_sim_still_offline
		outValue: con_sim_back_online
	)
	Exit (inCondition: con_sim_back_online)

	HMI_GetParams
	(
		outSliderOffset_Levo: con_cdfa0586_f37e_4f70_a544_c134ceddba36
		outSliderOffset_Desno: Nil
	)

	Analiza
	(
		inImage: con_377635aa_2f54_4be8_8f31_8a34ef8bdcf6
		inSliderOffset: con_cdfa0586_f37e_4f70_a544_c134ceddba36
		outAlarm1: con_sim_alarm1
		outAlarm2: con_sim_alarm2
		outImageCropped: con_sim_image_cropped
		outROI_Level1: con_sim_roi_level1
		outROI_Level2: con_sim_roi_level2
	)

	HMI_UpdateDetections_Levo
	(
		inImageCropped: con_sim_image_cropped
		inROI_Level1: con_sim_roi_level1
		inROI_Level2: con_sim_roi_level2
		inAlarm1: con_sim_alarm1
		inAlarm2: con_sim_alarm2
	)

	HMI_UpdateDetections_Desno
	(
		inImageCropped: con_sim_image_cropped
		inROI_Level1: con_sim_roi_level1
		inROI_Level2: con_sim_roi_level2
		inAlarm1: con_sim_alarm1
		inAlarm2: con_sim_alarm2
	)

	queue Push
	{
		port: Queue_Levo_Level1
	}
	(
		inOverflowControl: Nil
		inValue: con_sim_alarm1
		outOverflow: Nil
	)

	queue Push
	{
		port: Queue_Levo_level2
	}
	(
		inOverflowControl: Nil
		inValue: con_sim_alarm2
		outOverflow: Nil
	)

	queue Push
	{
		port: Queue_Desno_Level1
	}
	(
		inOverflowControl: Nil
		inValue: con_sim_alarm1
		outOverflow: Nil
	)

	queue Push
	{
		port: Queue_Desno_Level2
	}
	(
		inOverflowControl: Nil
		inValue: con_sim_alarm2
		outOverflow: Nil
	)
}

//:SECTIONSVISIBILITY Visible
//:USETYPE DISABLEDWORKER
public Simulacija_TestBeckhoff()
{

section INITIALIZE:
	Beckhoff_Init
	(
	)

section PROCESS:
	Beckhoff_SetSemaforSirena
	(
		inSelect: Sirena
		inStatus: ON
	)

	Delay
	(
		inTime: 1000
	)

	Beckhoff_SetSemaforSirena
	(
		inSelect: Sirena
		inStatus: OFF
	)
}
